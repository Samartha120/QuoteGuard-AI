# QuoteGuard AI - Environment Configuration

# Application Mode & API Keys
ENVIRONMENT=development
DEMO_MODE=true
GROUNDING_THRESHOLD=0.80

# LLM Provider Configuration (OpenAI Compatible)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Vector Database Configuration
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Database Configuration
DATABASE_URL=sqlite:///./app/db/quoteguard.db

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# SMTP 2FA Email Configuration (Required for sending real OTPs to Gmail/Outlook)
# NOTE: For Gmail, generate a 16-character App Password at https://myaccount.google.com/apppasswords
# Use Port 465 (SSL) for reliable delivery in cloud environments (Oracle Cloud / AWS)
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=QuoteGuard AI
SMTP_TLS=true
