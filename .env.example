# QuoteGuard AI - Environment Configuration

# Application Mode & API Keys
ENVIRONMENT=development
DEMO_MODE=true
GROUNDING_THRESHOLD=0.80

# LLM Provider Configuration (OpenAI Compatible)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Vector Database Configuration
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Database Configuration
DATABASE_URL=sqlite:///./app/db/quoteguard.db

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000
