ENVIRONMENT=development
DEMO_MODE=true
GROUNDING_THRESHOLD=0.80

OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Local alternative: OPENAI_API_KEY=ollama, OPENAI_BASE_URL=http://localhost:11434/v1, OPENAI_MODEL=llama3

# Let the supervisor LLM choose between legal next moves
ORCHESTRATOR_USE_LLM=true

CHROMA_PERSIST_DIRECTORY=./data/chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

DATABASE_URL=sqlite:///./app/db/quoteguard.db
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000
